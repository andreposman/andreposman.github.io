---
interface PinnedRepo {
	repo: string;
	description?: string;
	language?: string;
	stars?: number;
	link: string;
}

interface Props {
	lang: ReturnType<typeof import('../i18n/index')['t']>;
}

const { lang } = Astro.props;
const t = lang(Astro.currentLocale);

let repos: PinnedRepo[] = [];
let fetchFailed = false;

try {
	const res = await fetch('https://gh-pinned-repos.egoist.dev/?username=andreposman');
	if (res.ok) {
		repos = await res.json();
	}
} catch { /* fall through to fallback */ }

if (repos.length === 0) {
	try {
		const res = await fetch(
			'https://api.github.com/users/andreposman/repos?sort=updated&per_page=6&type=owner',
			{ headers: { Accept: 'application/vnd.github.v3+json' } },
		);
		if (res.ok) {
			const data = await res.json();
			repos = data
				.filter((r: any) => !r.fork)
				.slice(0, 6)
				.map((r: any) => ({
					repo: r.name,
					description: r.description,
					language: r.language,
					stars: r.stargazers_count,
					link: r.html_url,
				}));
		} else {
			fetchFailed = true;
		}
	} catch {
		fetchFailed = true;
	}
}
---

<section class="projects" id="projects">
	<hr class="hr-divider projects-divider-top" />
	<div class="projects-inner">
		<p class="kicker"><span class="kicker-accent">02</span> — {t.projects.kicker}</p>
		<h2 class="section-heading reveal-line"
			><span class="reveal-line-inner">{t.projects.heading}</span></h2
		>

		<div class="project-rows">
			{
				fetchFailed
					? repos.length === 0 && (
							<p class="project-fallback">{t.projects.fallbackTitle}</p>
						)
					: repos.map((repo) => (
							<a
								class="project-row"
								href={repo.link}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="project-index"
									>{repo.language ?? '—'}
								</span>
								<span class="project-name">{repo.repo}</span>
								<span class="project-description"
									>{repo.description ?? ''}</span
								>
								<span class="project-arrow" aria-hidden="true">&rarr;</span>
							</a>
						))
			}
		</div>
	</div>
</section>

<style>
	.projects {
		padding: 0 1.5rem 5rem;
	}

	.projects-inner {
		max-width: 64rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.projects-divider-top {
		max-width: 64rem;
		margin: 0 auto 5rem;
	}

	.project-rows {
		margin-top: 1rem;
		border-top: 1px solid var(--fg-dim);
	}

	.project-row {
		display: grid;
		grid-template-columns: 9rem 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--fg-dim);
		text-decoration: none;
		color: inherit;
		opacity: 0.9;
		transition: opacity 0.25s ease;
	}

	.project-row:hover {
		opacity: 1;
	}

	.project-row:hover .project-name {
		color: var(--accent);
	}

	.project-index {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--fg-dim);
	}

	.project-name {
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 2.8vw, 2.2rem);
		font-weight: 400;
		transition: color 0.25s ease;
	}

	.project-description {
		grid-column: 2 / 3;
		font-size: 0.9rem;
		color: var(--fg-dim);
		line-height: 1.5;
		max-width: 26rem;
	}

	.project-arrow {
		grid-row: 1 / 3;
		grid-column: 3 / 4;
		font-size: 1.25rem;
		color: var(--fg-dim);
	}

	.project-fallback {
		padding: 2rem 0;
		color: var(--fg-dim);
		font-style: italic;
	}

	@media (max-width: 42rem) {
		.project-row {
			grid-template-columns: 1fr auto;
		}

		.project-index {
			grid-column: 1 / 2;
		}

		.project-name {
			grid-column: 1 / 2;
		}

		.project-description {
			grid-column: 1 / 2;
		}

		.project-arrow {
			grid-row: 1 / 4;
		}
	}

	.reveal-line {
		display: block;
		overflow: hidden;
		margin: 0;
	}

	.reveal-line-inner {
		display: block;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const inners = document.querySelectorAll('.projects .reveal-line-inner');
	const rows = document.querySelectorAll('.projects .project-row');

	if (reduceMotion) {
		gsap.set(inners, { yPercent: 0, opacity: 1 });
		gsap.set(rows, { opacity: 1, y: 0 });
	} else {
		gsap.set(inners, { yPercent: 110, opacity: 0 });
		gsap.set(rows, { opacity: 0, y: 16 });
		gsap.to(inners, {
			yPercent: 0,
			opacity: 1,
			duration: 0.8,
			ease: 'power4.out',
			scrollTrigger: {
				trigger: '.projects',
				start: 'top 70%',
				toggleActions: 'play none none reverse',
			},
		});
		gsap.to(rows, {
			opacity: 1,
			y: 0,
			duration: 0.6,
			ease: 'power3.out',
			stagger: 0.08,
			scrollTrigger: {
				trigger: '.project-rows',
				start: 'top 80%',
				toggleActions: 'play none none reverse',
			},
		});
	}
</script>
